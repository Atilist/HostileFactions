{
  "schemaVersion": 1,
  "id": "hostilefactions",
  "version": "${version}",

  "name": "Hostile Factions",
  "description": "Generates self-expanding NPC bases with drones which can either work or fight. These factions will eventually search and attack players",
  "authors": [
    "Atilist"
  ],
  "contact": {
    "homepage": "https://glass-launcher.net/",
    "sources": "https://github.com/calmilamsy/stationapi-example-mod"
  },

  "license": "MIT",
  "icon": "assets/hostilefactions/icon.png",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "io.github.atilist.hostilefactions.events.init.InitListener"
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ]
  },
  "mixins": [
    "hostilefactions.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
